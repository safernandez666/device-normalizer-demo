# ─────────────────────────────────────────────────────────────────────────
# Device Normalizer · frontend env vars
#
# The demo runs with NO .env at all because the mock layer is on by default.
# Copy this file to `.env` (or `.env.local`, `.env.production`, …) only when
# you want to swap the mock data for a real backend.
# ─────────────────────────────────────────────────────────────────────────

# Where /api/* and /auth/* calls go.
# - Empty (default): same origin as the frontend (recommended — serve the
#   frontend and backend behind the same proxy / framework).
# - Cross-origin: full URL of the backend, e.g. https://api.example.com
VITE_API_BASE_URL=

# Synthetic mock layer.
# - true (default): src/lib/mock-fetch.ts intercepts /api/* and /auth/* so
#   the demo runs with no backend at all.
# - false: skip the mock. All fetches go to the network. Required to talk
#   to a real backend. Vite tree-shakes mock-fetch.ts out of the build.
VITE_USE_MOCK=true
